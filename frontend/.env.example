# Frontend local config. No secrets here — web auth is an httpOnly cookie,
# never JS-visible. Only AUTOCRM_* values are read (see next.config.js).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Rust API origin for the /api rewrite (default http://localhost:8080).
AUTOCRM_API_URL=http://localhost:8080
# S3-compatible storage origin for presigned image URLs (default shown).
AUTOCRM_S3_URL=http://localhost:9000
