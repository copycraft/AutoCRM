# Frontend local config. No secrets here — web auth is an httpOnly cookie,
# never JS-visible. Only AUTOCRM_* values are read (see next.config.js).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Rust API origin for the /api rewrite (default http://localhost:8080).
AUTOCRM_API_URL=http://localhost:8080
# S3-compatible storage origin for presigned image URLs (default shown).
AUTOCRM_S3_URL=http://localhost:9000

# The public data-protection page (/hu/adatkezeles). Read at request time by the web server,
# so a change needs a restart, not a rebuild. A line left empty is simply not shown.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTROLLER_REGISTRATION=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_PHONE=
# Where the full Adatkezelési tájékoztató is published; adds a button to the page.
PRIVACY_NOTICE_URL=
