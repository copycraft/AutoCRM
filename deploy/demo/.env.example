# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# The two public hostnames you route through the tunnel.
APP_HOST=crm-demo.example.com
FILES_HOST=files.crm-demo.example.com

# Your tunnel forwards:  https://APP_HOST   -> http://<this server>:APP_PORT
#                       https://FILES_HOST -> http://<this server>:FILES_PORT
APP_PORT=3000
FILES_PORT=9000
# 127.0.0.1 when the tunnel runs on this machine; 0.0.0.0 when it runs on another one.
BIND_IP=127.0.0.1

# Only for the bundled cloudflared (docker compose --profile cloudflared): the token from
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command.
TUNNEL_TOKEN=

POSTGRES_PASSWORD=
S3_SECRET_KEY=
UPLOAD_SIGNING_KEY=

# Password for every demo login (admin@demo.local, iroda@..., tervezo@..., nezo@...).
DEMO_PASSWORD=

# Sign-in is only accepted from these browser origins (comma-separated). Default:
# https://APP_HOST. Add http://<server-ip>:APP_PORT to sign in over the LAN, and set
# COOKIE_SECURE=false for plain http.
# ALLOWED_ORIGINS=https://crm-demo.example.com,http://192.168.1.10:3000
# COOKIE_SECURE=false
