# Fixed backend settings for the showcase. Secrets and hostnames come from .env via
# docker-compose.yml. Nothing here sends real mail or reports invoices to NAV.
APP_ENV=staging
BIND_ADDR=0.0.0.0:8080
DATABASE_MAX_CONNECTIONS=10

S3_REGION=us-east-1
S3_BUCKET=autocrm
S3_ACCESS_KEY=autocrm
S3_FORCE_PATH_STYLE=true
S3_INTAKE_LOCK_YEARS=0

# Logged, never sent.
EMAIL_MODE=dry_run
EMAIL_FROM_AUTOMATIC=demo@demo.local
EMAIL_FROM_NAME=AutoCRM demo
EMAIL_REPLY_TO_DEFAULT=demo@demo.local
EMAIL_MESSAGE_ID_DOMAIN=demo.local
EMAIL_SENDER_DOMAINS=demo.local
EMAIL_REDIRECT_TO=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=

# NAV_SIDECAR_URL unset: invoicing is off.
LEADS_NOTIFY_TO=

MNB_ENDPOINT=http://www.mnb.hu/arfolyamok.asmx
BUSINESS_TIMEZONE=Europe/Budapest
WORKER_ENABLED=true
WORKER_ID=demo-1
LOG_FORMAT=json
LOG_DIR=
