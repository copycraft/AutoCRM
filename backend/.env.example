# Copy to .env for local development. Every value here is read by src/config.rs,
# which fails fast on anything missing or malformed.

# dev | staging | production
APP_ENV=dev
BIND_ADDR=127.0.0.1:8080
# Origins allowed to make cookie-authenticated state-changing requests (CSRF guard)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set false only for local http development; production cookies are always Secure
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://autocrm:autocrm@localhost:5432/autocrm
DATABASE_MAX_CONNECTIONS=10

# 32+ random bytes, hex or base64. Signs upload tokens. Rotate = in-flight uploads must restart.
UPLOAD_SIGNING_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autocrm
S3_ACCESS_KEY=autocrm
S3_SECRET_KEY=autocrm-dev-secret
S3_FORCE_PATH_STYLE=true
# Years of S3 Object Lock retention for intake photos. 0 disables (bucket must have locking enabled otherwise).
S3_INTAKE_LOCK_YEARS=10

# --- Email -------------------------------------------------------------------------------
# dry_run | smtp. dry_run writes the log row and logs the body; nothing leaves the machine.
EMAIL_MODE=dry_run

# A real, monitored mailbox or Google Group in your domain: suppliers reply to nudges.
EMAIL_FROM_AUTOMATIC=beszerzes@autotherm.hu
EMAIL_FROM_NAME=Autotherm
EMAIL_REPLY_TO_DEFAULT=iroda@autotherm.hu
EMAIL_MESSAGE_ID_DOMAIN=autotherm.hu
# Staff whose address is in these domains send manual mail as themselves (comma-separated).
EMAIL_SENDER_DOMAINS=autotherm.hu
# Deliver ALL mail to this one address instead of the real recipients (staging, parallel run).
# Required for EMAIL_MODE=smtp outside production unless SMTP_HOST is a local sink.
EMAIL_REDIRECT_TO=

# Local testing with Mailpit (docker compose --profile mail up -d mailpit):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=

# Production: Google Workspace SMTP relay. See docs/email-google-workspace.md
# EMAIL_MODE=smtp
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_HELO_NAME=autotherm.hu
# SMTP_FORCE_IPV4=true
# (leave SMTP_USERNAME/SMTP_PASSWORD empty when the relay authorises by IP address)

# --- NAV invoicing (Online Számla via the nav-sidecar) ---
# Unset NAV_SIDECAR_URL and invoicing is off: the invoice endpoints answer with a
# rule error naming the variable. Set it and the whole block below is required —
# half a supplier identity produces invoices NAV rejects with a customer waiting.
# Local testing: docker compose --profile nav up -d nav-sidecar (MOCK_MODE, no
# credentials), then point at it:
# NAV_SIDECAR_URL=http://localhost:8081
# The sidecar's SIDECAR_TOKEN (compose dev value below); at least 32 characters.
# NAV_SIDECAR_TOKEN=dev-sidecar-token-not-for-production-0000
# NAV_SIDECAR_TIMEOUT_SECONDS=90
# NAV_SUPPLIER_NAME=
# NAV_SUPPLIER_TAX_NUMBER=
# NAV_SUPPLIER_POSTAL_CODE=
# NAV_SUPPLIER_CITY=
# NAV_SUPPLIER_STREET_NAME=
# NAV_SUPPLIER_STREET_CATEGORY=
# NAV_SUPPLIER_STREET_NUMBER=
# NAV_SUPPLIER_BANK_ACCOUNT=
# NAV_DEFAULT_VAT_RATE=0.27
# NAV_INVOICE_PREFIX=AT
# NAV_PROFORMA_PREFIX=DB
# NAV_PAYMENT_DAYS=8

# --- Newsletter website signup ---
# Key the main website sends as `X-Newsletter-Key` to subscribe readers
# (POST /api/newsletter/subscribe). Unset and website signup is off.
# NEWSLETTER_API_KEY=

# --- Website enquiries ---
# Key the main website sends as `X-Leads-Key` to file an enquiry as a lead
# (POST /api/leads/website). Unset and the endpoint is off. `openssl rand -hex 32`.
# LEADS_API_KEY=

MNB_ENDPOINT=http://www.mnb.hu/arfolyamok.asmx
BUSINESS_TIMEZONE=Europe/Budapest

# Background worker
WORKER_ENABLED=true
WORKER_ID=local-1

LOG_FORMAT=pretty
LOG_DIR=
