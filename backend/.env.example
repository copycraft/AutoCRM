# Copy to .env for local development. Every value here is read by src/config.rs,
# which fails fast on anything missing or malformed.

# dev | staging | production
APP_ENV=dev
BIND_ADDR=127.0.0.1:8080
# Origins allowed to make cookie-authenticated state-changing requests (CSRF guard)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set false only for local http development; production cookies are always Secure
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://autocrm:autocrm@localhost:5432/autocrm
DATABASE_MAX_CONNECTIONS=10

# 32+ random bytes, hex or base64. Signs upload tokens. Rotate = in-flight uploads must restart.
UPLOAD_SIGNING_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autocrm
S3_ACCESS_KEY=autocrm
S3_SECRET_KEY=autocrm-dev-secret
S3_FORCE_PATH_STYLE=true
# Years of S3 Object Lock retention for intake photos. 0 disables (bucket must have locking enabled otherwise).
S3_INTAKE_LOCK_YEARS=10

# --- Email -------------------------------------------------------------------------------
# dry_run | smtp. dry_run writes the log row and logs the body; nothing leaves the machine.
EMAIL_MODE=dry_run

# A real, monitored mailbox or Google Group in your domain: suppliers reply to nudges.
EMAIL_FROM_AUTOMATIC=beszerzes@autotherm.hu
EMAIL_FROM_NAME=Autotherm
EMAIL_REPLY_TO_DEFAULT=iroda@autotherm.hu
EMAIL_MESSAGE_ID_DOMAIN=autotherm.hu
# Staff whose address is in these domains send manual mail as themselves (comma-separated).
EMAIL_SENDER_DOMAINS=autotherm.hu
# Deliver ALL mail to this one address instead of the real recipients (staging, parallel run).
# Required for EMAIL_MODE=smtp outside production unless SMTP_HOST is a local sink.
EMAIL_REDIRECT_TO=

# Local testing with Mailpit (docker compose --profile mail up -d mailpit):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=

# Production: Google Workspace SMTP relay. See docs/email-google-workspace.md
# EMAIL_MODE=smtp
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_HELO_NAME=autotherm.hu
# SMTP_FORCE_IPV4=true
# (leave SMTP_USERNAME/SMTP_PASSWORD empty when the relay authorises by IP address)

MNB_ENDPOINT=http://www.mnb.hu/arfolyamok.asmx
BUSINESS_TIMEZONE=Europe/Budapest

# Background worker
WORKER_ENABLED=true
WORKER_ID=local-1

LOG_FORMAT=pretty
LOG_DIR=
