{
  "db_name": "PostgreSQL",
  "query": "SELECT s.key, s.label, s.position, s.is_system, s.archived_at,\n                  (SELECT count(*) FROM leads l WHERE l.source = s.key) AS \"leads!\"\n           FROM lead_sources s\n           WHERE $1 OR s.archived_at IS NULL\n           ORDER BY s.position, s.label",
