{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.at, a.user_id, u.display_name AS \"user_name?\", a.entity, a.entity_id, a.action, a.changes\n           FROM audit_log a\n           LEFT JOIN users u ON u.id = a.user_id\n           WHERE a.entity = $1 AND a.entity_id = $2\n           ORDER BY a.at DESC, a.id DESC\n           LIMIT $3",
