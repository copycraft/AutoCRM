  "query": "SELECT id, vin, plate, plate_norm, make, model, year, partner_id, notes, created_at, updated_at\n           FROM vehicles\n          WHERE ($1::text IS NOT NULL AND plate_norm = $1)\n             OR ($2::text IS NOT NULL AND upper(vin) = $2)\n          ORDER BY (plate_norm = $1) DESC, id\n          LIMIT 1",
