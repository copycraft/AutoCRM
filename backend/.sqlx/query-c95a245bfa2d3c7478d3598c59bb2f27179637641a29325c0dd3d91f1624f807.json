{
  "db_name": "PostgreSQL",
  "query": "SELECT id, vin, plate, plate_norm, make, model, year, partner_id, notes, created_at, updated_at\n           FROM vehicles\n          WHERE $1::text IS NULL\n             OR make ILIKE $1 OR model ILIKE $1 OR vin ILIKE $1 OR notes ILIKE $1\n             OR ($2::text IS NOT NULL AND plate_norm LIKE '%' || $2 || '%')\n          ORDER BY id DESC\n          LIMIT $3 OFFSET $4",
