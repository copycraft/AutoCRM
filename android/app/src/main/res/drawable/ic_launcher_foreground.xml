<?xml version="1.0" encoding="utf-8"?>
<!--
  The snowflake from the web client's sidebar mark: six spokes with a pair of barbs on each.
  Drawn as strokes rather than filled paths so it stays legible at 48 dp on a launcher and
  in the monochrome themed-icon slot, where fills collapse into a blob.

  108 dp canvas with the art inside the middle 72 dp, as adaptive icons require — anything
  outside that can be cropped to a circle, a squircle or a rounded square by the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54">
        <!-- Vertical spoke -->
        <path
            android:pathData="M54,30 L54,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,36 L48,30 M54,36 L60,30 M54,72 L48,78 M54,72 L60,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path
            android:pathData="M54,30 L54,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,36 L48,30 M54,36 L60,30 M54,72 L48,78 M54,72 L60,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
    </group>

    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:pathData="M54,30 L54,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,36 L48,30 M54,36 L60,30 M54,72 L48,78 M54,72 L60,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
    </group>
</vector>
