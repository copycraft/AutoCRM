<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uploads continue while the phone is in a pocket; without this the system kills the
         worker mid-batch and the photos sit in the queue until the app is opened again. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only to tell the fitter a batch finished or needs attention. Denied is survivable:
         the queue screen carries the same information. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Handover inspections open a live in-app camera (CameraX). Without it an inspection
         cannot continue; the walkaround explains how to enable it. Photos never come from
         storage: there is deliberately no READ_MEDIA_IMAGES permission anywhere here. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Inspection photos are geotagged when available. Denied is survivable: the photo
         keeps its timestamp, zone and inspection, just without coordinates. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Voice notes on orders and leads (0049). Asked for only when one is recorded. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: without this the system camera intent cannot be
         resolved and the capture button crashes with ActivityNotFoundException. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".AutoCrmApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AutoCRM"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AutoCRM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share → AutoCRM" from the gallery, a chat or the mail app (0049): the files
                 are filed as documents of a chosen order or lead. Reading them needs no
                 storage permission: the sender grants this one URI. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- The "Mai feladataim" home-screen widget (0049). -->
        <receiver
            android:name=".widget.TasksWidgetReceiver"
            android:exported="true"
            android:label="@string/tasks_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!-- Hands a file:// path to the phone's own camera app as a content:// URI it may
             write to. The system camera is used rather than an in-app one: it is the app
             the fitter already knows, and its output is the full-quality original the
             evidence chain depends on. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The default WorkManager initialiser is removed and the queue is configured in
             AutoCrmApp instead, so the upload worker can be given the app's OkHttp client
             rather than building a second one with different timeouts. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
