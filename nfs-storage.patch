+    #[test]
+    fn tokens_bind_their_purpose_and_expire() {
+        let dir = scratch();
+        let s = store(&dir);
+        let put = s
+            .presign_put(
+                "a/b.jpg",
+                "image/jpeg",
+                3,
+                "AAAA",
+                None,
+                Duration::from_secs(60),
