+    .await
+    .unwrap();
+    let quote = b"%PDF quotation".to_vec();
+    let Completed::Document { document, .. } = upload(
+        &state,
+        &user,
+        Owner::Lead(lead.id),
+        UploadTarget::Document {
+            kind: DocumentKind::Other,
+            replaces: None,
+        },
+        "Árajánlat.pdf",
