+async fn storage_relayout(config: Config, from_s3: bool, dry_run: bool) -> anyhow::Result<()> {
+    let state = build_state(config).await?;
+    let fs = state
+        .storage
+        .as_fs()
+        .context("storage-relayout files onto the share: set STORAGE_BACKEND=fs and STORAGE_DIR")?;
