+    )
+    .await
+    else {
+        panic!("expected a document");
+    };
+    assert!(
+        document.storage_key.starts_with("ajanlatok/")
+            && document
+                .storage_key
+                .contains(&format!("/L{:06}_Huto-Bt/Arajanlat_", lead.id)),
+        "{}",
+        document.storage_key
+    );
+
+    let order = autocrm::service::leads::convert(
