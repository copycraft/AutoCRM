{
  "name": "autocrm-nav-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP sidecar wrapping open-nav, so the Rust backend never touches NAV's XML or crypto",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@open-nav/client": "^0.3.0",
    "@open-nav/core": "^0.3.0",
    "@open-nav/invoicing": "^0.3.0",
    "@open-nav/mock-server": "^0.3.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
