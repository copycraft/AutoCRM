# nav-sidecar configuration. Everything is read from the environment; no
# credential is ever accepted as a request parameter.

# --- Where it listens -------------------------------------------------------
PORT=8080
# Loopback by default: only the backend on the same machine should reach this.
# The Docker image sets 0.0.0.0 inside the container.
HOST=127.0.0.1

# --- Who may call it --------------------------------------------------------
# Every route but /health requires "Authorization: Bearer <SIDECAR_TOKEN>".
# Required unless MOCK_MODE=true; at least 32 characters. The backend sends the
# same value as NAV_SIDECAR_TOKEN. Generate one with: openssl rand -hex 32
SIDECAR_TOKEN=

# --- Mock mode --------------------------------------------------------------
# true starts an in-process fake NAV and points the client at it. No credentials
# are needed and nothing reaches the tax authority. Leave it unset in production.
MOCK_MODE=false

# --- NAV technical user (Online Számla portal → Technikai felhasználó) -------
# Required unless MOCK_MODE=true. The test and production systems issue
# separate, non-interchangeable users.
NAV_LOGIN=
NAV_PASSWORD=
NAV_SIGN_KEY=
NAV_EXCHANGE_KEY=
# The 8-digit core of the taxpayer's number — not the 11-digit form.
NAV_TAX_NUMBER=

# test (default) or production.
NAV_ENVIRONMENT=test

# --- Billing software identification (NAV requires it on every request) -----
# Exactly 18 characters of [0-9A-Z-]. There is no registry: prefix it with your
# 8-digit tax number to make it unique, and keep it stable across releases.
NAV_SOFTWARE_ID=
NAV_SOFTWARE_NAME=AutoCRM
NAV_SOFTWARE_DEV_CONTACT=dev@example.hu

# Optional.
# NAV_SOFTWARE_DEV_NAME=          # defaults to NAV_SOFTWARE_NAME
# NAV_SOFTWARE_VERSION=1.0        # the release version; not part of the id
# NAV_SOFTWARE_OPERATION=LOCAL_SOFTWARE   # or ONLINE_SERVICE
# NAV_SOFTWARE_DEV_COUNTRY_CODE=HU
# NAV_SOFTWARE_DEV_TAX_NUMBER=

# --- Optional tuning --------------------------------------------------------
# NAV_BASE_URL=                   # overrides NAV_ENVIRONMENT; for a mock elsewhere
# NAV_REQUEST_ID_PREFIX=          # prefix on generated requestIds, for tracing
# NAV_TIMEOUT_MS=30000            # per HTTP attempt towards NAV
# NAV_POLL_TIMEOUT_MS=60000       # how long to wait for a transaction's verdict
# NAV_POLL_INITIAL_DELAY_MS=1000
# PDF_LANGUAGE=hu                 # hu, en or de
# PROFORMA_TTL_SECONDS=3600       # how long a rendered proforma stays fetchable
# PROFORMA_CACHE_MAX=200
# BODY_LIMIT=1mb
