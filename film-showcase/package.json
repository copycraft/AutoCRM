{
  "name": "autocrm-showcase-film",
  "version": "0.1.0",
  "description": "Automated pipeline for the 2-minute AutoCRM showcase film: Playwright captures -> EffectCraft (After Effects-style local compositor) -> H.264 master.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --noEmit",
    "film": "tsx src/index.ts",
    "record:web": "tsx src/playwright/record-web.ts",
    "record:mobile": "tsx src/playwright/record-mobile.ts",
    "assemble": "tsx src/effectcraft/assemble.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
