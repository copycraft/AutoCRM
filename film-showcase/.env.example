# --- AutCRM showcase film pipeline configuration ---

# Web app (Next.js frontend). The mobile "app" shots emulate a tablet on the same app.
WEB_APP_URL=http://localhost:3000
MOBILE_APP_URL=http://localhost:3000

# Read admin credentials from the film accounts file (email / password pairs, "admin" line)
# falls back to ../backend/local-test-accounts.txt when missing
FILM_ACCOUNTS_FILE=../film/data/accounts.txt

# Real van photos (Scene 1 + outro). This folder sits next to this repo:
VAN_PHOTOS_ROOT=C:/Users/vasta/Documents/PROJECTS/autotherm-photos

# EffectCraft project to drive ("film-showcase show")
EFFECTCRAFT_PROJECT_NAME=showcase-film
# Optional: a command line that can run an ExtendScript into EffectCraft head-less
# e.g. "EffectCraftScript.exe --run" ; when empty the pipeline writes
# effectcraft/build-showcase.js and tells you to run it inside EffectCraft once.
EFFECTCRAFT_CLI=
# Where EffectCraft writes the rendered master (checked/poll by index.ts if watching)
EFFECTCRAFT_EXPORT_PATH=output/showcase-master.mp4

# Optional audio bed (music). If empty, a silent track is structured in the plan.
AUDIO_BED_PATH=

# Recording quality
CAPTURE_SCALE=2
CAPTURE_FPS=30

# Total film length (seconds)
FILM_DURATION=120
